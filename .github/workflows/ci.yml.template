# Rename this file to ci.yml only AFTER:
# 1) npm install has generated package-lock.json
# 2) lint/typecheck/test/build all pass locally
# 3) package-lock.json is committed
name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22.22.3
          cache: npm
      - run: npm ci
      - run: npm run lint
      - run: npm run typecheck
      - run: npm run test
      - run: npm run build
