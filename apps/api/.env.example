NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL example only. Change user/password/database for your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_english_elearning?schema=public
SHADOW_DATABASE_URL=postgresql://smart_elearning_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/smart_elearning_shadow?schema=public

# Generate a long random value for each local environment. Never commit the real value.
SESSION_SECRET=REPLACE_WITH_LOCAL_SESSION_SECRET

# Required only when manually running the development seed.
SEED_DEFAULT_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSWORD

# External integrations are not wired in the skeleton yet.
AI_PROVIDER=
OPENAI_API_KEY=
STORAGE_PROVIDER=
