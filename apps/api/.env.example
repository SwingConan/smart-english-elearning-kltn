NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated IP/CIDR allowlist for reverse proxies. Blank disables proxy trust.
# Safe built-in names loopback, linklocal, and uniquelocal are also supported.
TRUST_PROXY=

# Development may use console (message content is suppressed). Production requires smtp.
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# PostgreSQL example only. Change user/password/database for your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_english_elearning?schema=public
SHADOW_DATABASE_URL=postgresql://smart_elearning_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/smart_elearning_shadow?schema=public

# Generate a long random value for each local environment. Never commit the real value.
SESSION_SECRET=REPLACE_WITH_LOCAL_SESSION_SECRET

# Required only when manually running the development seed.
SEED_DEFAULT_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSWORD

# Optional override. By default the API resolves its tracked M05 media from the API package root.
ASSESSMENT_STIMULUS_MEDIA_ROOT=

# Explicit center-day configuration for the bounded source activity reports.
# Supported V2 target zone; missing/unsupported values leave reporting unavailable.
REPORT_CENTER_TIME_ZONE=Asia/Ho_Chi_Minh

# CMS is enabled only for a separately verified DEC-070 QA target with its own ledger.
# See apps/api/sql/cms/README.md. No role-wide or GLOBAL CMS grants are inferred.
W10_CMS_ENABLED=
W10_CMS_EXPECTED_DATABASE=
W10_CMS_VERIFIED_OID=
W10_CMS_PHYSICAL_ID=

# Optional integrated disposable QA binding. Defaults remain disabled.
# Requires runtime_v2.assert_target(), an immutable import receipt and the exact
# verified OID/physical identity. See sql/runtime/README.md; never use baseline.
V2_UNIFIED_RUNTIME=
V2_UNIFIED_DATABASE=
V2_UNIFIED_OID=
V2_UNIFIED_PHYSICAL=
V2_UNIFIED_DATASET_SHA256=

# SePay credentials stay in an ignored owner-only *.private.json, never in Git.
# Configure with scripts/configure-sepay-operator.ps1 after starting HTTPS callback.
SEPAY_CONFIG_FILE=
# Local contract checks do not create bank transactions; disabled outside QA.
SEPAY_CONTRACT_CHECKS=
SEPAY_CONTRACT_SECRET=

# External integrations are not wired in the skeleton yet.
AI_PROVIDER=
OPENAI_API_KEY=
STORAGE_PROVIDER=

# Placement AI Advisory Provider (Gemini / Offline Default)
# Supported providers: NONE (default, 100% offline, zero network) | GEMINI
PLACEMENT_AI_ADVISORY_PROVIDER=NONE

# Staging control gate: MUST be set to true for operator-controlled staging tests.
PLACEMENT_AI_ADVISORY_STAGING_ENABLED=false

# Gemini API Key: Inject only on operator-controlled server at runtime. NEVER commit!
GEMINI_API_KEY=

# Target Gemini model: choose a supported, low-cost API model from Google AI Studio.
GEMINI_ADVISORY_MODEL=gemini-2.5-flash

# Maximum timeout in milliseconds before triggering safe deterministic fallback.
PLACEMENT_AI_ADVISORY_TIMEOUT_MS=4500

# Daily call budget limit (0 = network disabled, positive integer = maximum calls/day).
PLACEMENT_AI_ADVISORY_DAILY_BUDGET_CALLS=0

# Independent verification gate: MUST remain false until operator and PO sign off live proof.
PLACEMENT_AI_ADVISORY_LIVE_VERIFIED=false
