  classSectionsCreated ClassSection[] @relation("SectionCreator")
  classSectionsUpdated ClassSection[] @relation("SectionUpdater")
  classActivitiesCreated ClassActivity[] @relation("ActivityCreator")
  classActivitiesUpdated ClassActivity[] @relation("ActivityUpdater")
  classRevisionsPublished ClassActivityRevision[] @relation("ActivityPublisher")
