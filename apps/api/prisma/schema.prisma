  W05BProfile_teacherId W05BProfile[] @relation("W05BProfile_teacherId")
  W05BProfileRevision_makerId W05BProfileRevision[] @relation("W05BProfileRevision_makerId")
  W05BProfileRevision_reviewerId W05BProfileRevision[] @relation("W05BProfileRevision_reviewerId")
  W05BAvailability_teacherId W05BAvailability[] @relation("W05BAvailability_teacherId")
  W05BBooking_teacherId W05BBooking[] @relation("W05BBooking_teacherId")
  W05BBooking_learnerId W05BBooking[] @relation("W05BBooking_learnerId")
  W05BLink_makerId W05BLink[] @relation("W05BLink_makerId")
  W05BLink_reviewerId W05BLink[] @relation("W05BLink_reviewerId")
  W05BChange_makerId W05BChange[] @relation("W05BChange_makerId")
  W05BChange_reviewerId W05BChange[] @relation("W05BChange_reviewerId")
  W05BReport_makerId W05BReport[] @relation("W05BReport_makerId")
  W05BCommand_actorId W05BCommand[] @relation("W05BCommand_actorId")
  W05BEvent_actorId W05BEvent[] @relation("W05BEvent_actorId")
  W05BOutbox_recipientId W05BOutbox[] @relation("W05BOutbox_recipientId")
  w07ClassControlActor W07ClassControl[] @relation("W07ClassControl_actor")
  w07ApplicationLearner W07Application[] @relation("W07Application_learner")
  w07AcademicDecisionReviewer W07AcademicDecision[] @relation("W07AcademicDecision_reviewer")
  w07EvidenceLearner W07Evidence[] @relation("W07Evidence_learner")
  w07PaymentEventActor W07PaymentEvent[] @relation("W07PaymentEvent_actor")
  w07AdjustmentMaker W07Adjustment[] @relation("W07Adjustment_maker")
  w07AdjustmentDecisionReviewer W07AdjustmentDecision[] @relation("W07AdjustmentDecision_reviewer")
  w07EntitlementLearner W07Entitlement[] @relation("W07Entitlement_learner")
  w07CaseLearner W07Case[] @relation("W07Case_learner")
  w07NotificationRecipient W07Notification[] @relation("W07Notification_recipient")
  w06MeetMaker W06Meet[] @relation("W06Meet_maker")
  w06MeetReviewer W06Meet[] @relation("W06Meet_reviewer")
  w06AttendanceActivityCreator W06AttendanceActivity[] @relation("W06AttendanceActivity_creator")
  w06CodeCreator W06Code[] @relation("W06Code_creator")
  w06ReceiptLearner W06Receipt[] @relation("W06Receipt_learner")
  w06CorrectionLearner W06Correction[] @relation("W06Correction_learner")
  w06CorrectionMaker W06Correction[] @relation("W06Correction_maker")
  w06CorrectionReviewer W06Correction[] @relation("W06Correction_reviewer")
  w06ExceptionMaker W06Exception[] @relation("W06Exception_maker")
  w06ExceptionRoutedby W06Exception[] @relation("W06Exception_routedBy")
  w06NotificationRecipient W06Notification[] @relation("W06Notification_recipient")
  w06RateLearner W06Rate[] @relation("W06Rate_learner")
 placementPoliciesAuthored PlacementWorkflowPolicy[] @relation("PlacementPolicyAuthor")
 placementPoliciesApproved PlacementWorkflowPolicy[] @relation("PlacementPolicyApprover")
 placementGradingAssignments PlacementGraderAssignment[] @relation("PlacementAssignedGrader")
 placementGradingAppointed PlacementGraderAssignment[] @relation("PlacementAssigner")
 placementHumanEvaluations PlacementHumanEvaluation[] @relation("PlacementEvaluationGrader")
 placementResultPublications PlacementResultRelease[] @relation("PlacementResultPublisher")
 placementWorkflowRequests PlacementWorkflowRequest[] @relation("PlacementRequestActor")
  knowledgeEntryCreator KnowledgeEntry[] @relation("KnowledgeEntryCreator")
  knowledgeEntryWithdrawer KnowledgeEntry[] @relation("KnowledgeEntryWithdrawer")
  knowledgeRevisionCreator KnowledgeRevision[] @relation("KnowledgeRevisionCreator")
  knowledgeRevisionReviewer KnowledgeRevision[] @relation("KnowledgeRevisionReviewer")
  knowledgeRevisionPublisher KnowledgeRevision[] @relation("KnowledgeRevisionPublisher")
  knowledgeLinkAuthor QuizKnowledgeLink[] @relation("KnowledgeLinkAuthor")
  knowledgeLinkReviewer QuizKnowledgeLink[] @relation("KnowledgeLinkReviewer")
  knowledgeLinkPublisher QuizKnowledgeLink[] @relation("KnowledgeLinkPublisher")
  knowledgeLinkWithdrawer QuizKnowledgeLink[] @relation("KnowledgeLinkWithdrawer")
  authoredQuizzes Test[] @relation("QuizAuthor")
  approvedQuizzes Test[] @relation("QuizApprover")
  publishedQuizzes TestAttempt[] @relation("QuizPublisher")
  assignmentRubricsAuthored Rubric[] @relation("AssignmentRubricAuthor")
  assignmentRubricsApproved Rubric[] @relation("AssignmentRubricApprover")
  assignmentGradesCreated AssignmentGrade[] @relation("AssignmentGradeCreator")
