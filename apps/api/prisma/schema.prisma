// Unified Q01 + Q07 Tuition Receivables, 15m Seat Hold Orders, SePay Transactions & Receipts
model TuitionReceivable {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId    String                @unique @db.Uuid
  learnerId       String                @db.Uuid
  classOfferingId String                @db.Uuid
  receivableCode  String                @unique
  amountVnd       Int
  paidAmountVnd   Int                   @default(0)
  currency        String                @default("VND")
  status          String
  dueAt           DateTime?
  paidAt          DateTime?
  isTestHarness   Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  enrollment      Enrollment            @relation("TuitionReceivableEnrollment", fields: [enrollmentId], references: [id], onDelete: Restrict)
  learner         User                  @relation("TuitionReceivableLearner", fields: [learnerId], references: [id], onDelete: Restrict)
  classOffering   ClassOffering         @relation("TuitionReceivableClass", fields: [classOfferingId], references: [id], onDelete: Restrict)
  paymentOrders   TuitionPaymentOrder[]
  transactions    SePayTuitionTransaction[]
  receipt         TuitionReceipt?
  reconciliationActions TuitionReconciliationAction[]

  @@index([learnerId, status])
  @@index([classOfferingId, status])
  @@map("tuition_receivables")
}

model TuitionPaymentOrder {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receivableId      String            @db.Uuid
  enrollmentId      String            @db.Uuid
  learnerId         String            @db.Uuid
  classOfferingId   String            @db.Uuid
  paymentCode       String            @unique
  expectedAmountVnd Int
  currency          String            @default("VND")
  bankCode          String?
  accountNumber     String?
  accountName       String?
  qrUrl             String?
  status            String
  expiresAt         DateTime
  releasedAt        DateTime?
  paidAt            DateTime?
  isTestHarness     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  receivable        TuitionReceivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  enrollment        Enrollment        @relation("TuitionPaymentOrderEnrollment", fields: [enrollmentId], references: [id], onDelete: Restrict)
  learner           User              @relation("TuitionPaymentOrderLearner", fields: [learnerId], references: [id], onDelete: Restrict)
  classOffering     ClassOffering     @relation("TuitionPaymentOrderClass", fields: [classOfferingId], references: [id], onDelete: Restrict)
  transactions      SePayTuitionTransaction[]
  receipts          TuitionReceipt[]
  reconciliationActions TuitionReconciliationAction[]

  @@index([receivableId, status])
  @@index([enrollmentId, status])
  @@index([status, expiresAt])
  @@map("tuition_payment_orders")
}

model SePayTuitionTransaction {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              String               @default("SEPAY")
  bankAccountId         String
  providerTransactionId String
  orderId               String?              @db.Uuid
  receivableId          String?              @db.Uuid
  paymentCodeExtracted  String?
  amountVnd             Int
  currency              String               @default("VND")
  transferType          String               @default("in")
  content               String
  referenceCode         String?
  gateway               String?
  transactionDate       DateTime
  classification        String
  reconciliationState   String
  verificationSource    String
  verifiedBankApi       Boolean              @default(false)
  isTestHarness         Boolean              @default(false)
  rawHash               String
  semanticHash          String
  rawPayload            Json
  resolutionNote        String?
  resolvedById          String?              @db.Uuid
  resolvedGrantId       String?              @db.Uuid
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())
  order                 TuitionPaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receivable            TuitionReceivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  resolvedBy            User?                @relation("SePayTuitionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  receipt               TuitionReceipt?
  reconciliationActions TuitionReconciliationAction[]

  @@unique([bankAccountId, providerTransactionId])
  @@index([reconciliationState, createdAt])
  @@index([orderId])
  @@map("sepay_tuition_transactions")
}

model TuitionReceipt {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNumber      String                  @unique
  receivableId       String                  @unique @db.Uuid
  orderId            String?                 @db.Uuid
  transactionId      String                  @unique @db.Uuid
  learnerId          String                  @db.Uuid
  classOfferingId    String                  @db.Uuid
  amountVnd          Int
  currency           String                  @default("VND")
  issuedById         String?                 @db.Uuid
  verificationMethod String
  isTestHarness      Boolean                 @default(false)
  issuedAt           DateTime                @default(now())
  receivable         TuitionReceivable       @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  order              TuitionPaymentOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transaction        SePayTuitionTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  learner            User                    @relation("TuitionReceiptLearner", fields: [learnerId], references: [id], onDelete: Restrict)
  classOffering      ClassOffering           @relation("TuitionReceiptClass", fields: [classOfferingId], references: [id], onDelete: Restrict)
  issuedBy           User?                   @relation("TuitionReceiptIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([learnerId, issuedAt])
  @@map("tuition_receipts")
}

model TuitionReconciliationAction {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String?                  @db.Uuid
  receivableId  String?                  @db.Uuid
  orderId       String?                  @db.Uuid
  actorId       String?                  @db.Uuid
  grantId       String?                  @db.Uuid
  action        String
  previousState String?
  nextState     String
  note          String?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  transaction   SePayTuitionTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receivable    TuitionReceivable?       @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  order         TuitionPaymentOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor         User?                    @relation("TuitionReconActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@map("tuition_reconciliation_actions")
}
