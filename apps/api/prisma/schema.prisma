// Immutable audit is enforced by a PostgreSQL trigger, including direct SQL.
enum AcademicDecisionState {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  UNAVAILABLE
}

enum RoomCapability {
  PROJECTOR
  WHITEBOARD
  SPEAKERS
  COMPUTER
  ACCESSIBLE
}

enum SessionIntent {
  PUBLISH
  RESCHEDULE
  CANCEL
}

// W02B metadata/price versions; Module/Lesson versioning remains W03.
model CourseVersion {
  w07ApplicationVersion W07Application[] @relation("W07Application_version")
  w07ObligationVersion W07Obligation[] @relation("W07Obligation_version")
  id String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  number Int
  title String
  description String @db.Text
  level String
  skillScope CourseSkillScope
  standardPricingType PricingType?
  standardTuitionFeeVnd Int?
  effectiveFrom DateTime @db.Timestamptz(3)
  state AcademicDecisionState @default(DRAFT)
  proposedBy String @db.Uuid
  approvedBy String? @db.Uuid
  reason String @db.VarChar(500)
  decisionReason String? @db.VarChar(500)
  lockVersion Int @default(0)
  submittedAt DateTime? @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  course Course @relation(fields:[courseId], references:[id], onDelete:Restrict)
  proposer User @relation("VersionProposer",fields:[proposedBy], references:[id], onDelete:Restrict)
  approver User? @relation("VersionApprover",fields:[approvedBy], references:[id], onDelete:Restrict)
  offerings ClassOffering[]
  @@unique([courseId,number])
  @@index([state,effectiveFrom])
  @@map("course_versions")
}

model Room {
  w06ExceptionRoom W06Exception[] @relation("W06Exception_room")
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  location String
  capacity Int
  capabilities RoomCapability[]
  status RoomStatus @default(ACTIVE)
  createdBy String @db.Uuid
  lockVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  creator User @relation("RoomCreator",fields:[createdBy], references:[id], onDelete:Restrict)
  sessions TeachingSession[]
  defaultForClasses ClassOffering[] @relation("ClassDefaultRoom")
  scheduleSlots ClassScheduleSlot[]
  roadmapItems ClassRoadmapItem[]
  @@map("rooms")
}

model ClassInstructorAssignment {
  w06ExceptionAssignment W06Exception[] @relation("W06Exception_assignment")
  id String @id @default(uuid()) @db.Uuid
  classOfferingId String @db.Uuid
  instructorId String @db.Uuid
  effectiveFrom DateTime @db.Timestamptz(3)
  effectiveTo DateTime @db.Timestamptz(3)
  // Original approved interval is immutable; only approved supersession closes this reservation.
  reservedUntil DateTime @db.Timestamptz(3)
  replacesId String? @unique @db.Uuid
  state AcademicDecisionState @default(DRAFT)
  proposedBy String @db.Uuid
  approvedBy String? @db.Uuid
  eligibilityConfirmed Boolean @default(false)
  reason String @db.VarChar(500)
  decisionReason String? @db.VarChar(500)
  lockVersion Int @default(0)
  submittedAt DateTime? @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  classOffering ClassOffering @relation(fields:[classOfferingId], references:[id], onDelete:Restrict)
  instructor User @relation("AssignmentInstructor",fields:[instructorId], references:[id], onDelete:Restrict)
  proposer User @relation("AssignmentProposer",fields:[proposedBy], references:[id], onDelete:Restrict)
  approver User? @relation("AssignmentApprover",fields:[approvedBy], references:[id], onDelete:Restrict)
  replaces ClassInstructorAssignment? @relation("AssignmentHistory",fields:[replacesId], references:[id], onDelete:Restrict)
  replacement ClassInstructorAssignment? @relation("AssignmentHistory")
  sessions TeachingSession[]
  @@index([classOfferingId,state,effectiveFrom], map:"assignment_class_state_from_idx")
  @@map("class_instructor_assignments")
}

model TeachingSession {
  w06MeetSession W06Meet[] @relation("W06Meet_session")
  w06WindowSession W06Window[] @relation("W06Window_session")
  w06ExceptionSession W06Exception[] @relation("W06Exception_session")
  w06ExceptionRoutedsession W06Exception[] @relation("W06Exception_routedSession")
  w06NotificationSession W06Notification[] @relation("W06Notification_session")
  id String @id @default(uuid()) @db.Uuid
  occurrenceId String @default(uuid()) @db.Uuid
  revision Int @default(1)
  supersedesId String? @db.Uuid
  classOfferingId String @db.Uuid
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  timezone String
  modality ClassModality
  roomId String? @db.Uuid
  instructorId String? @db.Uuid
  assignmentId String? @db.Uuid
  requiredCapabilities RoomCapability[]
  sourceTemplateId String? @db.Uuid
  sourceTemplateUpdatedAt DateTime?
  generationKey String? @unique
  generatedFrom DateTime? @db.Date
  generatedThrough DateTime? @db.Date
  state AcademicDecisionState @default(DRAFT)
  intent SessionIntent @default(PUBLISH)
  proposedBy String @db.Uuid
  approvedBy String? @db.Uuid
  reason String @db.VarChar(500)
  decisionReason String? @db.VarChar(500)
  lockVersion Int @default(0)
  submittedAt DateTime? @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  classOffering ClassOffering @relation(fields:[classOfferingId], references:[id], onDelete:Restrict)
  room Room? @relation(fields:[roomId], references:[id], onDelete:Restrict)
  instructor User? @relation("SessionInstructor",fields:[instructorId], references:[id], onDelete:Restrict)
  assignment ClassInstructorAssignment? @relation(fields:[assignmentId], references:[id], onDelete:Restrict)
  sourceTemplate ClassScheduleSlot? @relation(fields:[sourceTemplateId], references:[id], onDelete:Restrict)
  proposer User @relation("SessionProposer",fields:[proposedBy], references:[id], onDelete:Restrict)
  approver User? @relation("SessionApprover",fields:[approvedBy], references:[id], onDelete:Restrict)
  supersedes TeachingSession? @relation("SessionHistory",fields:[supersedesId], references:[id], onDelete:Restrict)
  replacements TeachingSession[] @relation("SessionHistory")
  notifications AcademicNotificationIntent[]
  @@unique([occurrenceId,revision])
  @@index([classOfferingId,state,startsAt])
  @@index([instructorId,state,startsAt])
  @@map("teaching_sessions")
}

// Durable intent only. No outbound delivery or W06/attendance claim.
model AcademicNotificationIntent {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  recipientId String @db.Uuid
  kind SessionIntent
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  session TeachingSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  recipient User @relation("AcademicNotificationRecipient",fields:[recipientId],references:[id],onDelete:Restrict)
  @@unique([sessionId,recipientId])
  @@map("academic_notification_intents")
}

model DomainAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action String
  objectType String
  objectId String
  decision String
  reason String @db.VarChar(500)
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  @@index([objectType, objectId, createdAt])
  @@index([actorId, createdAt])
  @@map("domain_audit_events")
}

model PermissionGrant {
  w07AcademicDecisionGrant W07AcademicDecision[] @relation("W07AcademicDecision_grant")
  w07PaymentEventGrant W07PaymentEvent[] @relation("W07PaymentEvent_grant")
  w07AdjustmentDecisionGrant W07AdjustmentDecision[] @relation("W07AdjustmentDecision_grant")
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  capability String
  scopeType String
  scopeId String?
  requestedBy String @db.Uuid
  approvedBy String? @db.Uuid
  approvedAt DateTime?
  effectiveAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String? @db.Uuid
  reason String @db.VarChar(500)
  revokeReason String? @db.VarChar(500)
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  @@index([userId, capability, expiresAt])
  @@map("permission_grants")
}

model AccountRoleDecision {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  previousRole UserRole
  nextRole UserRole
  requestedBy String @db.Uuid
  approvedBy String? @db.Uuid
  effectiveAt DateTime?
  reason String @db.VarChar(500)
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  @@index([userId, createdAt])
  @@map("account_role_decisions")
}

