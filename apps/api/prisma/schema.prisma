  tuitionReceivables     TuitionReceivable[]     @relation("TuitionReceivableLearner")
  tuitionPaymentOrders   TuitionPaymentOrder[]   @relation("TuitionPaymentOrderLearner")
  sepayTuitionResolved   SePayTuitionTransaction[] @relation("SePayTuitionResolvedBy")
  tuitionReceipts        TuitionReceipt[]        @relation("TuitionReceiptLearner")
  tuitionReceiptsIssued  TuitionReceipt[]        @relation("TuitionReceiptIssuedBy")
  tuitionReconActions    TuitionReconciliationAction[] @relation("TuitionReconActor")
  testAttempts           TestAttempt[]           @relation("LearnerTestAttempts")
  answerEvaluations      AnswerEvaluation[]      @relation("EvaluationInstructor")
  studyRecommendations   StudyRecommendation[]   @relation("LearnerStudyRecommendations")
  passwordResetTokens    PasswordResetToken[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("password_reset_tokens")
}

model UserSession {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("user_sessions")
}

model Course {
  versions CourseVersion[]
  id                    String                       @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String                       @unique
  description           String                       @db.Text
  level                 String
  skillScope            CourseSkillScope             @default(LR)
  thumbnailUrl          String?
  defaultDurationWeeks  Int?
  defaultSessionsCount  Int?
  defaultPeriodsPerSession Int?
  defaultPricingType    PricingType?
  defaultTuitionFeeVnd  Int?
  isPublished           Boolean                      @default(false)
  createdById           String                       @db.Uuid
  createdBy             User                         @relation("CourseCreatedBy", fields: [createdById], references: [id])
  classOfferings        ClassOffering[]
  modules               Module[]
  questions             Question[]
  tests                 Test[]
  skills                Skill[]
  adaptivePolicy        CourseAdaptivePolicy?
  recommendationProfile CourseRecommendationProfile?
