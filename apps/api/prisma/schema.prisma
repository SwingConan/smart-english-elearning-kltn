  approvedVersions CourseVersion[] @relation("VersionApprover")
  createdRooms Room[] @relation("RoomCreator")
  proposedAssignments ClassInstructorAssignment[] @relation("AssignmentProposer")
  approvedAssignments ClassInstructorAssignment[] @relation("AssignmentApprover")
  effectiveAssignments ClassInstructorAssignment[] @relation("AssignmentInstructor")
  proposedSessions TeachingSession[] @relation("SessionProposer")
  approvedSessions TeachingSession[] @relation("SessionApprover")
