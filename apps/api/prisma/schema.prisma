generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Additive S10 recovery ledger. No historical assessment columns repurposed.
model ExamTaskProgress {
  protocolVersion Int @default(1)
  capture ExamTaskCapture?
  audioValidation ExamTaskAudioValidation?
  id               String             @id @default(uuid()) @db.Uuid
  attemptId        String             @db.Uuid
  testQuestionId   String             @db.Uuid
  learnerId        String             @db.Uuid
  epoch            String             @unique @default(uuid()) @db.Uuid
  parentEpoch      String?            @db.Uuid
  resetCount       Int                @default(0)
  contentVersion   String
  assetVersion     String
  mediaSha256      String
  mediaStorageKey  String
  mediaDurationMs  Int
  phase            String             @default("NOT_STARTED")
  revision         Int                @default(0)
  started          Int                @default(0)
  completed        Int                @default(0)
  leaseSessionHash String?
  leaseTabHash     String?
  leaseTokenHash   String?
  leaseExpiresAt   DateTime?
  playNonceHash    String?
  playIssuedAt     DateTime?
  mediaRead        Boolean            @default(false)
  responseDeadline DateTime?
  uploadDigest     String?
  savedAnswerId    String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attempt          TestAttempt        @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  testQuestion     TestQuestion       @relation(fields: [testQuestionId], references: [id], onDelete: Restrict)
  events           ExamTaskEvent[]
  receipts         ExamTaskReceipt[]
  uploads          ExamTaskUpload[]
  parent           ExamTaskProgress?  @relation("S10EpochHistory", fields: [parentEpoch], references: [epoch], onDelete: Restrict)
  children         ExamTaskProgress[] @relation("S10EpochHistory")
  savedAnswer      TestAnswer?        @relation("S10SavedAnswer", fields: [savedAnswerId], references: [id], onDelete: Restrict)

  @@unique([attemptId, testQuestionId, resetCount])
  @@index([attemptId, testQuestionId, createdAt])
  @@map("exam_task_progress")
}

model ExamTaskEvent {
  id         String           @id @default(uuid()) @db.Uuid
  progressId String           @db.Uuid
  actorId    String?          @db.Uuid
  actorKind  String           @default("USER")
  action     String
  accepted   Boolean
  code       String?
  reason     String?          @db.VarChar(500)
  revision   Int
  createdAt  DateTime         @default(now())
  progress   ExamTaskProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)

  @@index([progressId, createdAt])
  @@map("exam_task_events")
}

model ExamTaskReceipt {
  id          String           @id @default(uuid()) @db.Uuid
  progressId  String           @db.Uuid
  actorHash   String
  key         String           @db.Uuid
  fingerprint String
  outcome     Json
  createdAt   DateTime         @default(now())
  progress    ExamTaskProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)

  @@unique([progressId, actorHash, key])
  @@map("exam_task_receipts")
}

// Reserve a storage key before file creation; commit answer/reference atomically.
model ExamTaskUpload {
  id         String           @id @default(uuid()) @db.Uuid
  progressId String           @db.Uuid
  key        String           @db.Uuid
  digest     String
  storageKey String           @unique
  mimeType   String
  bytes      Int
  status     String           @default("STAGED")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  progress   ExamTaskProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)

  @@unique([progressId, key])
  @@index([status, createdAt])
  @@map("exam_task_uploads")
}

// DEC-045: version2 is opt-in on newly created attempts. Originals stay protected.
model ExamTaskCapture {
  progressId String @id @db.Uuid
  prepareKey String @unique @db.Uuid
  nonceHash String @unique
  phase String @default("ARMED")
  armedAt DateTime
  armExpiresAt DateTime
  startedAt DateTime?
  deadline DateTime?
  stoppedAt DateTime?
  stopDigest String?
  progress ExamTaskProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)
  @@map("exam_task_captures")
}
model ExamTaskAudioValidation {
  progressId String @id @db.Uuid
  digest String
  storageKey String?
  bytes Int
  status String
  code String?
  codec String?
  sampleRate Int?
  sampleCount Int?
  channels Int?
  decoderIdentity String
  sourceSha256 String
  createdAt DateTime @default(now())
  progress ExamTaskProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)
  @@map("exam_task_audio_validations")
}

// Must accompany ADMIN_COORDINATOR. No automatic grants or new actors.
model ExamRecoveryPermission {
  userId    String    @id @db.Uuid
  grantedBy String    @db.Uuid
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("exam_recovery_permissions")
}

